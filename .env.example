# Supabase: use a separate development project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Server only. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Dedicated S3 bucket for public listing and avatar images.
# The public variables must match their server-side counterparts.
AWS_REGION=us-west-2
S3_BUCKET_NAME=your-public-images-bucket
NEXT_PUBLIC_AWS_REGION=us-west-2
NEXT_PUBLIC_S3_BUCKET_NAME=your-public-images-bucket
# Server only. Use credentials scoped to the dedicated images bucket.
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Optional email delivery. Leave the API key empty to disable.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Barter <onboarding@resend.dev>
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional sample data: set only for a disposable development project.
# Must exactly match NEXT_PUBLIC_SUPABASE_URL to acknowledge the seed target.
SEED_TARGET_URL=
# Unique development-only password, at least 16 characters.
SEED_PASSWORD=
